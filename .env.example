# ==============================================================================
# LAZUARDI RESOURCES MANAGEMENT SYSTEM (LRMS) — ENVIRONMENT VARIABLES
# ==============================================================================
# Salin file ini menjadi .env (development lokal) atau atur di Vercel Environment Variables.
# JANGAN PERNAH menyimpan secret asli atau service_role key di repository Git!

# --- AI Studio / Runtime ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# --- Supabase (WAJIB untuk mode production) ---
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- Domain & Keamanan ---
ALLOWED_EMAIL_DOMAIN="lazuardi.sch.id"
CRON_SECRET="GENERATE_RANDOM_32_CHAR_HEX_SECRET"
SIGNED_URL_SECRET="GENERATE_RANDOM_32_CHAR_HEX_SECRET"

# --- Email Server-Side (Untuk Laporan Bulanan Kepala Unit & Notifikasi) ---
# Pilih salah satu: SMTP Sekolah (Google Workspace / Mail Server) atau Resend API
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resources@lazuardi.sch.id"
SMTP_PASS="YOUR_APP_PASSWORD"
EMAIL_FROM="Divisi Resources Lazuardi <resources@lazuardi.sch.id>"
# Alternatif Resend:
# RESEND_API_KEY="re_xxxxxxxxxxxxx"
